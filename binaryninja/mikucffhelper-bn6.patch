+def deflate_auto(bv, func):
+    """Select the custom workflow and enable its automatic CFF activity.
+
+    Binary Ninja 6 no longer exposes the per-activity selector in the Function
+    Settings context menu used by the original README. Keep the same operation
+    available as an ordinary function plugin command.
+    """
+    Settings().set_string(
+        "analysis.workflows.functionWorkflow", "MikuCffHelper_workflow", func
+    )
+    workflow = Workflow("MikuCffHelper_workflow", object_handle=func.handle)
+    workflow._machine.override_set("analysis.plugins.workflow_patch_mlil", False)
+    workflow._machine.override_set(
+        "analysis.plugins.workflow_patch_mlil_switch", False
+    )
+    workflow._machine.override_set(
+        "analysis.plugins.workflow_patch_mlil_auto", True
+    )
+    func.reanalyze()
+    log_info(f"Requested auto CFF deflattening: {func.name} @ {func.start:#x}")
+
+
+def export_cff_graph(bv, func):
+    """Export Miku's non-mutating CFF analysis as JSON for external review."""
+    from .passes.mid.deflatHardPass import (
+        _collect_side_effect_signatures,
+        _collect_state_vars,
+        _detect_dispatcher_entry,
+        _function_looks_like_cff,
+        _identify_dispatcher_subgraph,
+        build_real_block_transition_graph,
+    )
+    from .passes.mid.synthesizeSwitchPass import (
+        _candidate_state_vars_ranked,
+        _collect_dispatcher_case_values,
+        _collect_transitions_for_var,
+    )
+
+    mlil = func.mlil
+    if mlil is None:
+        log_error(f"No MLIL for {func.name}")
+        return
+    dispatcher = _detect_dispatcher_entry(mlil)
+    if dispatcher is None:
+        log_error(f"No dispatcher for {func.name}")
+        return
+    state_vars = _collect_state_vars(mlil, dispatcher)
+    dispatcher_blocks = _identify_dispatcher_subgraph(
+        mlil, dispatcher, state_vars
+    )
+
+    def address(index):
+        try:
+            return mlil[index].address
+        except Exception:
+            return 0
+
+    candidates = []
+    for variable in _candidate_state_vars_ranked(mlil, state_vars):
+        transitions, assigned, fully_resolved = _collect_transitions_for_var(
+            mlil,
+            variable,
+            state_vars,
+            dispatcher_blocks,
+            dispatcher.start,
+            float("inf"),
+        )
+        case_values = _collect_dispatcher_case_values(
+            mlil, dispatcher_blocks, variable
+        )
+        candidates.append(
+            {
+                "name": variable.name,
+                "identifier": variable.identifier,
+                "transitions": {
+                    f"0x{value:x}": {
+                        "mlil_index": target,
+                        "address": f"0x{address(target):x}",
+                    }
+                    for value, target in sorted(transitions.items())
+                },
+                "assigned_values": [
+                    f"0x{value:x}" for value in sorted(assigned)
+                ],
+                "case_values": [
+                    f"0x{value:x}" for value in sorted(case_values)
+                ],
+                "fully_resolved": fully_resolved,
+            }
+        )
+
+    real_graph = build_real_block_transition_graph(mlil)
+    output = {
+        "function": func.name,
+        "start": f"0x{func.start:x}",
+        "looks_like_cff": _function_looks_like_cff(mlil, state_vars),
+        "dispatcher": {
+            "mlil_index": dispatcher.start,
+            "address": f"0x{address(dispatcher.start):x}",
+        },
+        "dispatcher_blocks": [
+            {
+                "mlil_index": index,
+                "address": f"0x{address(index):x}",
+            }
+            for index in sorted(dispatcher_blocks)
+        ],
+        "candidates": candidates,
+        "real_block_graph": {
+            f"0x{address(source):x}": [
+                f"0x{address(target):x}" for target in sorted(targets)
+            ]
+            for source, targets in sorted(real_graph.items())
+        },
+        "side_effects": [
+            {"operation": operation, "address": f"0x{location:x}"}
+            for operation, location in sorted(
+                _collect_side_effect_signatures(mlil),
+                key=lambda item: item[1],
+            )
+        ],
+    }
+    path = Path(f"/tmp/miku-cff-{func.start:x}.json")
+    path.write_text(json.dumps(output, indent=2) + "\n")
+    log_info(f"Exported CFF graph: {path}")


 register_workflow()
